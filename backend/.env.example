# Copy to backend/.env and fill in. NEVER commit the real .env.
# Generate secrets with:  python -c "import secrets,base64;print(secrets.token_urlsafe(48))"
ENVIRONMENT=development            # production disables /api/docs and refuses the mock verifier
DATABASE_URL=postgresql+psycopg://attendance:<POSTGRES_PASSWORD>@127.0.0.1:5432/attendance

JWT_SECRET=<48+ random chars>
QR_SIGNING_KEY=<48+ random chars>
DEVICE_HASH_KEY=<32+ random chars>

# AES-256-GCM keys for face templates: comma-separated "version:base64(32 bytes)".
# Generate one: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# To rotate: add v2, set TEMPLATE_ACTIVE_KEY_VERSION=v2, keep v1 until templates are re-encrypted/re-enrolled.
TEMPLATE_KEYS=v1:<base64 32 bytes>
TEMPLATE_ACTIVE_KEY_VERSION=v1

# Optional tuning (defaults shown). Re-tune FACE_MATCH_THRESHOLD from measured FAR/FRR before rollout.
# FACE_VERIFIER=sface
# FACE_MATCH_THRESHOLD=0.363
# QR_ROTATION_SECONDS=20
# MAX_ATTEMPTS_PER_SESSION=3
# ATTEMPT_COOLDOWN_SECONDS=5
# RATE_LIMIT_STORAGE=memory://       # use redis://host:6379 when running more than one worker
